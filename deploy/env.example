# 城市物語 Urban Tales —— 正式環境變數範本
#
# 正式位置：/etc/urban-tales/urban-tales.env（權限 640、root:<服務帳號>，**不進版控**）
# 由 systemd 的 EnvironmentFile 讀入。改完要 `sudo systemctl restart urban-tales` 才生效。
#
# ⚠️ 格式規則：等號兩側不要有空格；值裡有空白時用單引號包起來。
# ⚠️ 同一個變數名不要出現兩次 —— systemd 取「最後一次」出現的值，
#    上面填了、下面留一行空的，會把你填的值蓋掉，而錯誤訊息完全指不到這裡。
#    （這是 Roku 專案 2026-08-31 實際踩過的坑，bootstrap.sh 有一道檢查會抓。）

# ── 資料庫（必要）──────────────────────────────────────────────
# ★ 只走 127.0.0.1。PostgreSQL 不對外開放，開發機要連請走 SSH 通道。
#   密碼由 bootstrap.sh 產生後填進來（它會印在畫面上，只印一次）。
DATABASE_URL=postgres://urban_tales:__填密碼__@127.0.0.1:5432/urban_tales

# ── 身分（必要）────────────────────────────────────────────────
# ★ 32 bytes 以上的隨機字串。在場憑證與展示模式的金鑰都是從它推導的，
#   換掉它 = 所有玩家的身分與在場憑證同時失效。
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── AI 供應商（必要）───────────────────────────────────────────
# ★ 變數名不綁供應商。現況是 Gemini 的 OpenAI 相容端點。
#   金鑰在 aistudio.google.com 產生（免費層，不用綁卡）。
# ★ 留空 = mock 模式，回固定字串不呼叫 API。正式環境留空等於整個對話系統是假的。
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ⚠️ 主要模型必須是 flash-lite 那一級。理由見 .env.example 的實測數字：
#    medium 思考的中位數 8.05 秒，而我們的逾時是 8 秒。
AI_MODEL_PRIMARY=gemini-3.5-flash-lite
AI_MODEL_FALLBACK=gemini-3.7-flash

# ── 用量控制（SDD §10.1 四層防線）──────────────────────────────
GLOBAL_DAILY_BUDGET_USD=2.00
PLAYER_DAILY_MESSAGES=120
DEMO_DAILY_MESSAGES=40
MAX_INPUT_CHARS=200

# ── 展示模式（SDD §5.4）────────────────────────────────────────
# 作品集頁面上要放的通關密語。★ 留空 = 展示模式關閉（不是任何人都能進）。
DEMO_PASSPHRASE=

# ── 網域（必要）────────────────────────────────────────────────
# ★ adapter-node 靠這個知道自己對外的網址。沒設的話它只看得到
#   http://127.0.0.1:3000，絕對網址與 OAuth 回呼都會錯。
#   ⚠️ 結尾不要加斜線。
ORIGIN=https://__填網域__

# 正式站的完整網址，用於 OAuth 回呼與絕對連結（前端也讀得到，PUBLIC_ 前綴會進 bundle）
PUBLIC_SITE_URL=https://__填網域__

# ── 其他 ───────────────────────────────────────────────────────
# 正式環境務必是 false —— /dev/gps 那類開發頁面靠它關閉
ENABLE_DEV_TOOLS=false

# ── Google 綁定（P4，現在可留空）───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
