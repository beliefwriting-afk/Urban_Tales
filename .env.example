# 環境變數範本 —— SDD §13.1
# 複製成 .env 後填入實際值。★ .env 不進 git。

# ── AI（Zeabur AI Hub）────────────────────────────────
# ★ 金鑰在 Dashboard 建立時只顯示一次，當場存好
# ★ 留空 = 本機 mock 模式，不呼叫真的 API、不燒點數（SDD §13.2）
AIHUB_API_KEY=
AIHUB_BASE_URL=https://hnd1.aihub.zeabur.ai/v1
AIHUB_MODEL_PRIMARY=gemini-2.5-flash-lite
AIHUB_MODEL_FALLBACK=gemini-2.5-flash

# ── 用量控制（SDD §10.1 四層防線）─────────────────────
GLOBAL_DAILY_BUDGET_USD=2.00
PLAYER_DAILY_MESSAGES=120
DEMO_DAILY_MESSAGES=40
MAX_INPUT_CHARS=200

# ── 身分 ───────────────────────────────────────────────
# 32 bytes 以上的隨機字串。產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 展示模式（SDD §5.4）────────────────────────────────
DEMO_PASSPHRASE=

# ── 其他 ───────────────────────────────────────────────
# 本機開發用；Zeabur 上由平台自動注入
DATABASE_URL=postgres://postgres:postgres@localhost:5432/urban_tales
ENABLE_DEV_TOOLS=true
PUBLIC_SITE_URL=http://localhost:5173
