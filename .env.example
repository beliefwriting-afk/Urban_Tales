# 環境變數範本 —— SDD §13.1
# 複製成 .env 後填入實際值。★ .env 不進 git。

# ── AI 供應商 ─────────────────────────────────────────
# ★ 變數名不綁供應商：換一家只換值，不改程式碼也不改變數名。
#   現況：Gemini 的 OpenAI 相容端點（金鑰在 aistudio.google.com 產生，免費層）
# ★ 金鑰在 Dashboard 建立時只顯示一次，當場存好
# ★ 留空 = 本機 mock 模式，不呼叫真的 API、不燒點數（SDD §13.2）
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# ⚠️⚠️ 模型選擇的關鍵不是強弱，是「預設 thinking level」。⚠️⚠️
#
# 你在 Roku 專案的 VM 上實測過（2026-09-01，真實 SYSTEM_PROMPT，中位數）：
#     gemini-3.7-flash（預設 medium）        8.05 秒   範圍 4.71–13.91
#     gemini-3.5-flash-lite（預設 minimal）  0.74 秒   範圍 0.58–0.98   ← 快 11 倍且穩定
#
# ★ SDD §6.5 的逾時是 8 秒。medium 思考的中位數就是 8.05 秒
#   ——用它當主要模型，一半以上的對話會逾時走保底台詞。
#   所以主要模型必須是 flash-lite 那一級，這不是省錢考量，是能不能用的問題。
#
# ★ 我們比 LINE bot 更禁不起慢：玩家是站在廟口等回覆的。
AI_MODEL_PRIMARY=gemini-3.5-flash-lite
AI_MODEL_FALLBACK=gemini-3.7-flash

# ── 用量控制（SDD §10.1 四層防線）─────────────────────
GLOBAL_DAILY_BUDGET_USD=2.00
PLAYER_DAILY_MESSAGES=120
DEMO_DAILY_MESSAGES=40
MAX_INPUT_CHARS=200

# ── 身分 ───────────────────────────────────────────────
# 32 bytes 以上的隨機字串。產生方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 展示模式（SDD §5.4）────────────────────────────────
DEMO_PASSPHRASE=

# ── 其他 ───────────────────────────────────────────────
# 本機開發：透過 SSH 通道連到 VM 上的 PostgreSQL（見 deploy/README.md）
#   ssh -i <金鑰> -N -L 55432:127.0.0.1:5432 <帳號>@<VM 外部 IP>
# 正式環境：/etc/urban-tales/urban-tales.env，走 127.0.0.1:5432
DATABASE_URL=postgres://<帳號>:<密碼>@127.0.0.1:55432/urban_tales
ENABLE_DEV_TOOLS=true
PUBLIC_SITE_URL=http://localhost:5173
